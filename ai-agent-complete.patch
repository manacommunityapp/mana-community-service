-    public ValidatedUser validateFullAccess(Long userId, Long communityId,
-                                            String claimedRole, Long auctionConfigId) {
-        // CHECK 1: User exists and is ACTIVE
-        var results = entityManager.createQuery(
-                "SELECT u.id, u.communityId, u.role, u.kycVerified, u.displayName " +
-                "FROM AppUser u WHERE u.id = :userId AND u.status = 'ACTIVE'", Object[].class)
-                .setParameter("userId", userId).getResultList();
-        if (results.isEmpty()) {
-            log.warn("ACCESS DENIED: User {} not found or not active", userId);
-            throw new ChatAccessDeniedException("Account is not active or does not exist", userId);
-        }
-        Object[] user = results.get(0);
-
-        // CHECK 2: User belongs to claimed community
-        Long dbCommunityId = ((Number) user[1]).longValue();
-        if (!dbCommunityId.equals(communityId)) {
-            log.warn("ACCESS DENIED: User {} claimed community {} but DB says {}", userId, communityId, dbCommunityId);
-            throw new ChatAccessDeniedException("You are not a member of the requested community", userId);
-        }
-
-        // CHECK 3: Token role matches DB role
-        String dbRole = (String) user[2];
-        if (claimedRole != null && !claimedRole.equalsIgnoreCase(dbRole)) {
-            log.warn("ACCESS DENIED: User {} claimed role '{}' but DB says '{}'", userId, claimedRole, dbRole);
-            throw new ChatAccessDeniedException("Session role mismatch. Please log out and log back in.", userId);
-        }
-
-        // CHECK 4: KYC verification
-        boolean kycVerified = user[3] != null && (Boolean) user[3];
-        try {
-            var kycResults = entityManager.createQuery(
-                    "SELECT c.kycRequiredForChat FROM Community c WHERE c.id = :communityId", Boolean.class)
-                    .setParameter("communityId", communityId).getResultList();
-            if (!kycResults.isEmpty() && Boolean.TRUE.equals(kycResults.get(0)) && !kycVerified) {
-                throw new ChatAccessDeniedException("KYC verification required for chat access.", userId);
-            }
-        } catch (ChatAccessDeniedException e) {
-            throw e;
-        } catch (Exception e) {
-            log.debug("KYC check skipped (Community entity may not have kycRequiredForChat field): {}", e.getMessage());
-        }
-
-        // CHECK 5: Auction belongs to user's community
-        if (auctionConfigId != null) {
-            Long count = entityManager.createQuery(
-                    "SELECT COUNT(c) FROM AuctionConfig c WHERE c.id = :configId AND c.communityId = :communityId", Long.class)
-                    .setParameter("configId", auctionConfigId)
-                    .setParameter("communityId", communityId).getSingleResult();
-            if (count == 0) {
-                log.warn("ACCESS DENIED: User {} tried auction {} not in community {}", userId, auctionConfigId, communityId);
-                throw new ChatAccessDeniedException("Auction is not part of your community", userId);
-            }
-        }
-
-        // CHECK 6: Team ownership
-        Long teamId = null;
-        if ("AUCTION_TEAM_OWNER".equalsIgnoreCase(dbRole)) {
-            var teamResults = entityManager.createQuery(
-                    "SELECT t.id FROM AuctionTeam t JOIN AuctionConfig c ON t.configId = c.id " +
-                    "WHERE t.ownerUserId = :userId AND c.communityId = :communityId ORDER BY c.id DESC", Long.class)
-                    .setParameter("userId", userId).setParameter("communityId", communityId)
-                    .setMaxResults(1).getResultList();
-            teamId = teamResults.isEmpty() ? null : teamResults.get(0);
-        }
-
-        String displayName = (String) user[4];
-        log.info("ACCESS VALIDATED: user={}, community={}, role={}, team={}", userId, communityId, dbRole, teamId);
-        return new ValidatedUser(userId, communityId, dbRole, teamId, displayName, kycVerified);
-    }
-}
-VALEOF
