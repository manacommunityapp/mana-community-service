+                "s.name, s.icon, v.name, v.address, v.city, " +
+                "t.registrationStatus " +
+                "FROM SportsEvent e " +
+                "LEFT JOIN e.sport s LEFT JOIN e.venue v LEFT JOIN e.tournament t " +
