-    private static final Logger log = LoggerFactory.getLogger(ChatAgentService.class);
-    private final ChatClient chatClient;
-
-    public ChatAgentService(ChatClient chatClient) { this.chatClient = chatClient; }
-
-    public ChatResponse chat(ChatRequest request, ValidatedUser user) {
-        log.info("Chat: user={}, role={}, community={}", user.userId(), user.role(), user.communityId());
-        String convId = "user-" + user.userId() + (request.getConversationId() != null
-                ? "-conv-" + request.getConversationId() : "-" + System.currentTimeMillis());
-
-        ChatSecurityContext.set(new ChatSecurityContext.UserContext(
-                user.userId(), user.communityId(), user.role(),
-                user.teamId(), user.displayName(), user.kycVerified()));
-        try {
-            String reply = chatClient.prompt()
-                    .system(s -> s.text(buildPrompt(user, request.getAuctionConfigId())))
-                    .user(request.getMessage())
-                    .advisors(a -> a.param("chat_memory_conversation_id", convId))
-                    .call().content();
-            return new ChatResponse(request.getConversationId(),
-                    reply != null ? reply : "I couldn't generate a response. Please try again.");
-        } catch (Exception e) {
-            log.error("Chat error: user={}", user.userId(), e);
-            return new ChatResponse(request.getConversationId(), "I encountered an error. Please try again.");
-        } finally { ChatSecurityContext.clear(); }
-    }
-
-    public reactor.core.publisher.Flux<String> chatStream(ChatRequest request, ValidatedUser user) {
-        String convId = "user-" + user.userId() + "-" + System.currentTimeMillis();
-        ChatSecurityContext.set(new ChatSecurityContext.UserContext(
-                user.userId(), user.communityId(), user.role(),
-                user.teamId(), user.displayName(), user.kycVerified()));
-        return chatClient.prompt()
-                .system(s -> s.text(buildPrompt(user, request.getAuctionConfigId())))
-                .user(request.getMessage())
-                .advisors(a -> a.param("chat_memory_conversation_id", convId))
-                .stream().content().doFinally(sig -> ChatSecurityContext.clear());
-    }
-
-    private String buildPrompt(ValidatedUser user, Long auctionConfigId) {
-        StringBuilder sb = new StringBuilder();
-        sb.append("RULES: Only community %d data. No deletes. No unauthorized writes.\n".formatted(user.communityId()));
-        sb.append("USER: %s (ID: %d) ROLE: %s\n".formatted(
-                user.displayName() != null ? user.displayName() : "User", user.userId(), user.role()));
-        if ("SUPER_ADMIN".equals(user.role())) sb.append("ADMIN: Can update auction status + reset unsold (with confirm). No deletes.\n");
-        else if ("AUCTION_TEAM_OWNER".equals(user.role())) {
-            sb.append("TEAM OWNER: Read-only on all data. ");
-            if (user.teamId() != null) sb.append("Owns team ID: %d\n".formatted(user.teamId()));
-        } else sb.append("VIEWER: Read-only access.\n");
-        if (auctionConfigId != null) sb.append("AUCTION ID: %d — pass to all tools.\n".formatted(auctionConfigId));
