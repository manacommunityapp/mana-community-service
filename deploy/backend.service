[Unit]
Description=Mana Community Backend Service
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mana-community/backend

# Log directory — logback-spring.xml reads this via ${LOG_DIR:-logs}
Environment=LOG_DIR=/var/log/mana-community
Environment=SPRING_PROFILES_ACTIVE=dev

# These MUST be set via systemctl edit backend --force (override file)
# or in /etc/mana-community/env. Never commit real secrets to git.
EnvironmentFile=-/etc/mana-community/env

# JASYPT_ENCRYPTOR_PASSWORD is read from /etc/mana-community/env
# and used to decrypt ENC(...) values in config at startup.
ExecStart=/bin/bash -c 'exec /usr/bin/java -Xms256m -Xmx512m \
  -DLOG_DIR=/var/log/mana-community \
  -Djasypt.encryptor.password=${JASYPT_ENCRYPTOR_PASSWORD} \
  -Dspring.profiles.active=prod \
  -jar manacommunity.jar --spring.profiles.active=prod'

Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mana-backend

[Install]
WantedBy=multi-user.target
