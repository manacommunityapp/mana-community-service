# /etc/mana-community/env
# Copy this file to /etc/mana-community/env on the Lightsail instance.
# Never commit the real file to git.
#
# DB credentials and JWT secret have encrypted defaults in application-prod.yaml.
# Only the master key below is needed to decrypt them at startup.

# ── Encryption master key (REQUIRED) ──
JASYPT_ENCRYPTOR_PASSWORD=YOUR_MASTER_KEY_HERE

# ── CORS (REQUIRED) ──
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Overrides (optional — only set if different from encrypted defaults) ──
# DB_URL=jdbc:postgresql://YOUR_DB_HOST:5432/manacommunity
# DB_USERNAME=ENC(encrypted_value)
# DB_PASSWORD=ENC(encrypted_value)
# JWT_SECRET=ENC(encrypted_value)

# ── Mail (optional) ──
APP_MAIL_ENABLED=false
# MAIL_HOST=
# MAIL_USERNAME=
# MAIL_PASSWORD=

# ── Encrypt a value ──
# java -Dloader.main=com.manacommunity.api.config.EncryptablePropertyProcessor \
#   -cp manacommunity.jar org.springframework.boot.loader.launch.PropertiesLauncher \
#   encrypt "YOUR_MASTER_KEY" "plaintext-value"
