# /etc/mana-community/env (prod) or /etc/mana-community/env-dev (dev)
# Copy this file to the appropriate path on the Lightsail instance.
# Never commit the real file to git.

# ── Encryption master key (REQUIRED) ──
JASYPT_ENCRYPTOR_PASSWORD=YOUR_MASTER_KEY_HERE

# ── JWT signing secret (REQUIRED — must be at least 32 characters) ──
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ── CORS (REQUIRED) ──
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Mail (optional) ──
APP_MAIL_ENABLED=false
# MAIL_HOST=
# MAIL_USERNAME=
# MAIL_PASSWORD=

# ── Encrypt a value ──
# java -Dloader.main=com.manacommunity.api.config.EncryptablePropertyProcessor \
#   -cp manacommunity.jar org.springframework.boot.loader.launch.PropertiesLauncher \
#   encrypt "YOUR_MASTER_KEY" "plaintext-value"
