# /etc/mana-community/env
# Copy this file to /etc/mana-community/env on the Lightsail instance
# and fill in the real values. Never commit the real file to git.

# ── Database ──
DB_URL=jdbc:postgresql://3.109.145.130:5432/manacommunity
DB_USERNAME=manauser
DB_PASSWORD=manacommunity

# ── JWT ──
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ISSUER=mana-community

# ── CORS ──
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Mail (optional) ──
APP_MAIL_ENABLED=false
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=

# ── reCAPTCHA (optional) ──
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=
