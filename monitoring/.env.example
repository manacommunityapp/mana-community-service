# Copy to .env and edit. docker-compose reads these.

# Where the Spring Boot app is reachable FROM the Prometheus container.
#   App on the same host as Docker:   host.docker.internal:8080
#   App on another EC2 box / private IP:  10.0.1.20:8080
MANA_TARGET=host.docker.internal:8080

# http for local/dev, https if the app is behind TLS.
MANA_SCHEME=http

# Free-text label applied to scraped metrics (local | dev | prod).
MANA_ENV=local

# Grafana admin password (user is "admin"). Change it.
GRAFANA_ADMIN_PASSWORD=change-me
